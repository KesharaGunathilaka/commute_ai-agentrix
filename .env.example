# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development        # development | production
LOG_LEVEL=INFO

# ── RAG / ChromaDB ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=models/text-embedding-004

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=1024

# ── Groq (free tier — console.groq.com, no billing needed) ──────────────────
GROQ_API_KEY=

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300      # 5 minutes

# ── Agent limits ──────────────────────────────────────────────────────────────
MAX_REPLAN_ATTEMPTS=2

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Origins allowed to call the API. The Next.js dev server runs on :3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Next.js frontend map ──────────────────────────────────────────────────────
# Maps JavaScript API key served to the browser for the route map. This is
# SEPARATE from GOOGLE_MAPS_API_KEY above: that one is a server key and must
# never reach the browser. A browser key is publicly visible by design, so
# restrict it by HTTP referrer in the Google Cloud console and enable only the
# "Maps JavaScript API".
# Leave blank to disable the map — the UI falls back to a stop-list view.
GOOGLE_MAPS_BROWSER_KEY=
